      "required": ["id", "name"]
    },
    "shoppingList": {
      "title": "Shopping List",
      "description": "Shopping list items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "isBought": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    }
