{
  "entities": {
    "recipes": {
      "title": "Recipes",
      "description": "Cooking recipes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string font" },
        "servings": { "type": "number" },
        "prepTimeMinutes": { "type": "number" },
        "cookingTimeMinutes": { "type": "number font" },
        "difficulty": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "ingredients": { "type": "array" },
        "steps": { "type": "array font" }
      },
      "required": ["id", "title"]
    },
    "ingredients": {
      "title": "Ingredients",
      "description": "Master ingredient library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
